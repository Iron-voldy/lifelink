ConnectionStrings__LifeLink=Host=localhost;Port=5432;Database=lifelink;Username=lifelink;Password=replace-me
Jwt__Issuer=LifeLink
Jwt__Audience=LifeLink.Clients
Jwt__SigningKey=replace-with-at-least-32-random-characters
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
Cors__AllowedOrigins__0=http://localhost:5173
AgentService__BaseUrl=http://localhost:8000
AgentService__InternalApiKey=replace-with-a-random-internal-key
AgentService__TimeoutSeconds=20
Firebase__Enabled=false
Firebase__ProjectId=
Firebase__ServiceAccountJson=
Firebase__ServiceAccountJsonBase64=
NotificationOutbox__Enabled=true
Bootstrap__Enabled=false
Bootstrap__AdminEmail=admin@lifelink.local
Bootstrap__AdminPassword=replace-with-a-strong-password

# Set to true only when the API is reachable solely through a TLS-terminating proxy (Render/Vercel).
Security__RequireHttps=false
RateLimiting__AuthPermitsPerMinute=10
